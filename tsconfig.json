{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node20",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@api/*": [
        "./src/api/*"
      ],
      "@config/*": [
        "./src/config/*"
      ],
      "@constants/*": [
        "./src/constants/*"
      ],
      "@data/*": [
        "./src/data/*"
      ],
      "@helpers/*": [
        "./src/helpers/*"
      ],
      "@pages/*": [
        "./src/pages/*"
      ],
      "@tests/*": [
        "./tests/*"
      ],
      "@models/*": [
        "./src/types/*"
      ]
    }
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}