{
    "name": "automation",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "get-tags": "playwright test --list --reporter=./src/scripts/tag-analyzer-setup.ts",
        "test": "playwright test",
        "test:unit": "playwright test -c playwright.unit.config.ts",
        "test:ui": "playwright test --ui",
        "test:headed": "playwright test --headed",
        "setup": "ts-node -r tsconfig-paths/register src/scripts/setup.ts",
        "report": "playwright show-report",
        "allure:generate": "allure generate ./allure-results --config ./allurerc.js --output ./allure-report",
        "allure:open": "allure open ./allure-report",
        "allure:report": "npm run allure:generate && npm run allure:open",
        "allure:generate:mobile": "allure generate ./allure-results-mobile --config ./allurerc.js --output ./allure-report-mobile",
        "allure:open:mobile": "allure open ./allure-report-mobile",
        "allure:report:mobile": "npm run allure:generate:mobile && npm run allure:open:mobile",
        "lint": "eslint . --ext .ts",
        "lint:fix": "eslint . --ext .ts --fix",
        "typecheck": "tsc --noEmit",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "jira": "node scripts/jira/jira-client.mjs",
        "jira:sprint": "node scripts/jira/jira-client.mjs sprint",
        "jira:mcp": "node scripts/jira/jira-mcp-server.mjs",
        "jira:check": "node scripts/jira/check-connection.mjs",
        "jira:metadata": "node scripts/jira/discover-metadata.mjs",
        "figma": "node scripts/figma/figma-client.mjs",
        "validate": "node core/validate/validate-control-plane.mjs && node scripts/validate/validate-jira-guardrails.mjs",
        "validate:jira": "node scripts/validate/validate-jira-guardrails.mjs",
        "prepare": "husky",
        "test:mobile": "node mobile/config/run-mobile.mjs",
        "test:mobile:stable": "node mobile/config/run-mobile.mjs --spec mobile/specs/example/app-launch.spec.ts --spec mobile/specs/vetify/ayuda.spec.ts --spec mobile/specs/vetify/credential-wizard.spec.ts --spec mobile/specs/vetify/facturas.spec.ts --spec mobile/specs/vetify/historial-atencion.spec.ts --spec mobile/specs/vetify/login.spec.ts --spec mobile/specs/vetify/navigation.spec.ts --spec mobile/specs/vetify/pets.spec.ts --spec mobile/specs/vetify/plans.spec.ts --spec mobile/specs/vetify/profile.spec.ts --spec mobile/specs/vetify/reintegros.spec.ts",
        "test:android": "wdio run ./mobile/config/wdio.android.conf.ts",
        "test:ios": "wdio run ./mobile/config/wdio.ios.conf.ts",
        "emulator:start": "emulator -avd Pixel_6_QA -no-snapshot"
    },
    "dependencies": {
        "@playwright/test": "^1.60.0",
        "@types/node": "^22.15.0",
        "@typescript-eslint/eslint-plugin": "^8.60.1",
        "@typescript-eslint/parser": "^8.60.1",
        "allure": "^3.13.1",
        "allure-js-commons": "^3.10.1",
        "allure-playwright": "^3.10.1",
        "dotenv": "^16.5.0",
        "eslint": "^8.57.1",
        "eslint-plugin-playwright": "^2.10.4",
        "luxon": "^3.7.2",
        "prettier": "^3.9.4",
        "ts-node": "^10.9.1",
        "tsconfig-paths": "^4.0.0",
        "typescript": "^5.8.0",
        "uuid": "^9.0.1",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "@playwright/mcp": "^0.0.78",
        "@types/luxon": "^3.7.1",
        "@types/mocha": "^10.0.0",
        "@types/uuid": "^10.0.0",
        "@wdio/allure-reporter": "^9.0.0",
        "@wdio/appium-service": "^9.0.0",
        "@wdio/cli": "^9.0.0",
        "@wdio/globals": "^9.0.0",
        "@wdio/local-runner": "^9.0.0",
        "@wdio/mocha-framework": "^9.0.0",
        "@wdio/spec-reporter": "^9.0.0",
        "@wdio/types": "^9.0.0",
        "appium": "^3.0.0",
        "appium-uiautomator2-driver": "^8.2.2",
        "husky": "^9.1.7",
        "prettier-plugin-organize-imports": "^4.3.0",
        "puppeteer-core": "^25.6.0"
    }
}
