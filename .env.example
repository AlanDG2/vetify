APP_ENV=qa

# ── Jira Integration ──────────────────────────────────────────────────────────
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_API_TOKEN=your_api_token_here
JIRA_PROJECT_KEY=PROJ

# ── Figma Integration ─────────────────────────────────────────────────────────
# Personal access token: figma.com/settings > Security > Personal access tokens
# File key: from the file URL figma.com/design/<FILE_KEY>/<name>
FIGMA_API_TOKEN=your_figma_token_here
FIGMA_FILE_KEY=

VETIFY_INSTITUTIONAL_BASE_URL=https://qa.vetify.com.ar
VETIFY_WEBAPP_BASE_URL=https://vetify-qa.ikeapp.com

OSDE_CAPITADO_INSTITUTIONAL_BASE_URL=https://qa.vetify.com.ar/osde
OSDE_ADQUIRIENTE_INSTITUTIONAL_BASE_URL=https://qa.vetify.com.ar/mas-osde-beneficios
FLUX_CAPITADO_INSTITUTIONAL_BASE_URL=https://qa.vetify.com.ar/flux

# WebApp de Iké (legacy, sistema separado de Vetify) — IMAS-3742
IKE_WEBAPP_BASE_URL=https://ikeargentina-qa.ikeapp.com

AUTH_API_BASE_URL=https://ike-webapp-staging.us.auth0.com

# Required only when Salesforce validations are implemented/enabled.
SALESFORCE_BASE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
