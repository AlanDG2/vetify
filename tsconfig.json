{
    "compilerOptions": {
        "target": "ES2022",
        "module": "node20",
        "moduleResolution": "nodenext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "types": ["node"],
        "paths": {
            "@api/*": ["./src/api/*"],
            "@config/*": ["./src/config/*"],
            "@constants/*": ["./src/constants/*"],
            "@data/*": ["./src/data/*"],
            "@helpers/*": ["./src/helpers/*"],
            "@integrations/*": ["./src/integrations/*"],
            "@pages/*": ["./src/pages/*"],
            "@report/*": ["./src/report/*"],
            "@tests/*": ["./tests/*"],
            "@models/*": ["./src/types/*"],
            "@providers/*": ["./src/providers/*"]
        }
    },
    "include": ["**/*.ts", "src/scripts/report-clean-up-tests.js"],
    "exclude": ["node_modules"]
}
