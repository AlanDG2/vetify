APP_ENV=qa

# ── Jira Integration ──────────────────────────────────────────────────────────
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_API_TOKEN=your_api_token_here
JIRA_PROJECT_KEY=PROJ

# ── Figma Integration ─────────────────────────────────────────────────────────
# Personal access token: figma.com/settings > Security > Personal access tokens
# File key: from the file URL figma.com/design/<FILE_KEY>/<name>
FIGMA_API_TOKEN=your_figma_token_here
FIGMA_FILE_KEY=

VETIFY_INSTITUTIONAL_BASE_URL=https://qa.vetify.com.ar
# Dominio separado para catálogo/pago de Quantum (jengage) -- ver nota en src/config/environment.ts
VETIFY_QUANTUM_BASE_URL=https://qa-quantum.ike.ar
VETIFY_WEBAPP_BASE_URL=https://vetify-qa.ikeapp.com

OSDE_CAPITADO_INSTITUTIONAL_BASE_URL=https://qa.vetify.com.ar/osde
OSDE_ADQUIRIENTE_INSTITUTIONAL_BASE_URL=https://qa.vetify.com.ar/mas-osde-beneficios
FLUX_CAPITADO_INSTITUTIONAL_BASE_URL=https://qa.vetify.com.ar/flux

# WebApp de Iké (legacy, sistema separado de Vetify) — IMAS-3742
IKE_WEBAPP_BASE_URL=https://ikeargentina-qa.ikeapp.com

AUTH_API_BASE_URL=https://ike-webapp-staging.us.auth0.com

# Required only when Salesforce validations are implemented/enabled.
SALESFORCE_BASE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# ── Casilla de correo real para tests (lectura de email vía IMAP) ─────────────
# Opcional: sin esto, EmailClient falla explícito solo al usarse, no rompe el resto de la suite.
# Requiere una casilla REAL (Gmail u otro proveedor con IMAP habilitado) con contraseña de
# aplicación (no la contraseña de la cuenta) — ver IMP-006 en docs/impedimentos-bloqueos.md.
TEST_MAILBOX_IMAP_HOST=imap.gmail.com
TEST_MAILBOX_IMAP_PORT=993
TEST_MAILBOX_EMAIL=
TEST_MAILBOX_IMAP_PASSWORD=

# Casillas reales adicionales, una por producto Capitado (2026-09-01) — mismo host/puerto de
# arriba (todas Gmail), pero cuentas 100% separadas (no alias "+" de la principal: el formulario
# de registro de este sitio rechaza "+" en el email, ver qa-workspace/decision-log.md 2026-08-31).
TEST_MAILBOX_OSDE_CAPITADO_EMAIL=
TEST_MAILBOX_OSDE_CAPITADO_IMAP_PASSWORD=
TEST_MAILBOX_FLUX_CAPITADO_EMAIL=
TEST_MAILBOX_FLUX_CAPITADO_IMAP_PASSWORD=
TEST_MAILBOX_OSDE_ADQUIRENTE_EMAIL=
TEST_MAILBOX_OSDE_ADQUIRENTE_IMAP_PASSWORD=

# ── BrowserStack App Automate (iOS en la nube, desde Windows) ──────────────────
# Cuenta gratuita: https://www.browserstack.com/users/sign_up
# Subir el .app/.ipa desde https://app-live.browserstack.com/apps (botón "Upload")
# El hash se ve como: bs://a1b2c3d4e5f6... — pegarlo en BROWSERSTACK_IOS_APP.
BROWSERSTACK_USER=
BROWSERSTACK_KEY=
BROWSERSTACK_IOS_APP=
# (Opcional) Nombre identificable en el dashboard de BS. Si no está, usa la fecha.
# BROWSERSTACK_BUILD_NAME=
