# =============================================================================
# BrowserStack App Automate — credenciales para correr specs de iOS en la nube
# desde una máquina Windows (sin macOS local).
# =============================================================================
#
# 1) Crear cuenta gratis en https://www.browserstack.com/users/sign_up
#    El plan free incluye ~100 min/mes de testing en dispositivos reales + simuladores iOS.
#
# 2) Copiar este archivo a la raíz del repo como `.env` (NO commitearlo —
#    ya está en .gitignore, junto con el resto de secrets del proyecto).
#    Pegar los valores reales de las dos variables de abajo.
#
# 3) Compilar el .app de iOS en una Mac (o pedírselo a quien lo tenga) y subirlo
#    a BrowserStack. El sitio te devuelve un hash tipo:
#       bs://a1b2c3d4e5f6... (también llamado "app_url")
#    Pegar ese hash en BROWSERSTACK_IOS_APP.
#
# 4) Correr la suite:
#       npm run test:ios:bs
#    Para el set curado estable:
#       npm run test:ios:bs:stable
#
# =============================================================================

# Tu username de BrowserStack (visible en https://www.browserstack.com/accounts/profile)
BROWSERSTACK_USER=

# Access key de BrowserStack (MISMO link de arriba, abajo a la izquierda)
BROWSERSTACK_KEY=

# Hash de la app subida. Formato: bs://<hash>
# Subís el .app/.ipa desde https://app-live.browserstack.com/apps (botón "Upload")
# y el sitio te muestra el bs:// para copiar.
BROWSERSTACK_IOS_APP=

# (Opcional) Nombre identificable de la build en el dashboard de BrowserStack.
# Si no lo definís, se usa la fecha del día.
# BROWSERSTACK_BUILD_NAME=mi-rama-feature-x
